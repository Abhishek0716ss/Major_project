# Copy this file to .env.local before running the app.
# NEVER commit .env.local to git.

# --- Admin bootstrap (used once by `npm run create-admin`) ---
ADMIN_EMAIL=2023ci_jancykaverappap_a@nie.ac.in
# Set this only for the first `npm run create-admin` run, then remove it.
ADMIN_BOOTSTRAP_PASSWORD=ChangeThisImmediately!123

# --- Secrets (generate your own random values, do not reuse these) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_hex_string
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FACE_DATA_ENC_KEY=replace_with_64_hex_chars_32_bytes

# --- WebAuthn / Passkey config (localhost defaults, do not change for local dev) ---
RP_ID=localhost
RP_NAME=NIE Face Access Control
ORIGIN=http://localhost:3000

# --- Session ---
SESSION_COOKIE_NAME=facs_session
SESSION_TTL_HOURS=12
